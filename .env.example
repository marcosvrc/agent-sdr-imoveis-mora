SDR_ENV=dev
SDR_DATABASE_DSN=postgresql://sdr:sdr@localhost:5432/sdr
SDR_MODEL_CONVERSA=claude-sonnet-4-5
SDR_MODEL_ROTEAMENTO=claude-haiku-4-5
SDR_LLM_PROVIDER_FALLBACK=          # ex.: anthropic — assume quando o provedor primário cai
# Transcrição de áudio: auto = faster-whisper in-process.
SDR_TRANSCRICAO_PROVIDER=auto    # auto | whisper_local | off
SDR_WHISPER_MODEL=small          # tiny|base|small|medium|large-v3 (motor faster-whisper)
SDR_TELEGRAM_BOT_TOKEN=
SDR_TELEGRAM_BOT_USERNAME=

# Segurança
# Assina a sessão do chat do site (impede um visitante de entrar na conversa de outro).
# Sem valor, cada processo gera o seu no boot e as sessões caem a cada reinício.
SDR_SESSAO_SECRET=troque-por-uma-string-aleatoria-longa
SDR_PAINEL_TOKEN=                  # credencial do painel (API e WS papel=dashboard)
# Origens permitidas na API, separadas por vírgula. Vazio = "*", aceitável só no desenvolvimento.
SDR_CORS_ORIGINS=

# Google Agenda do corretor (opcional)
# Sem estas duas, a Mora usa a grade interna de horários e as visitas continuam sendo marcadas.
# Crie as credenciais em console.cloud.google.com → APIs e Serviços → Credenciais → ID do cliente OAuth
# (tipo "Aplicativo da Web") e cadastre a URI de redirecionamento abaixo.
SDR_GOOGLE_CLIENT_ID=
SDR_GOOGLE_CLIENT_SECRET=
SDR_GOOGLE_REDIRECT_URI=http://localhost:8000/calendario/callback

# CRM imobiliário (ver docs/decisions.md D-01). Vazio = ponte desligada.
# Endpoint do servidor MCP do CRM (não a REST) e a credencial do agente nele. Veja local/.env.example.
SDR_CRM_URL=
SDR_CRM_TOKEN=
