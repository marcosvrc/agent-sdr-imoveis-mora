# Execução MANUAL, no host (make cli, pytest, um serviço fora do container). O caminho da entrega
# é o compose, configurado por local/.env.example. Os endereços abaixo apontam para os serviços do
# compose vistos do host — portas deslocadas (5433, 6380, 11435) porque as padrão costumam estar
# ocupadas por instâncias nativas; ver DB_HOST_PORT/REDIS_HOST_PORT/OLLAMA_HOST_PORT em local/.env.
SDR_ENV=dev
SDR_DATABASE_DSN=postgresql://sdr:sdr@localhost:5433/sdr
SDR_REDIS_URL=redis://localhost:6380/0
SDR_OLLAMA_URL=http://localhost:11435
SDR_MODEL_CONVERSA=claude-sonnet-4-5
SDR_MODEL_ROTEAMENTO=claude-haiku-4-5
SDR_LLM_PROVIDER_FALLBACK=          # ex.: anthropic — assume quando o provedor primário cai
# Transcrição de áudio: auto = faster-whisper in-process.
SDR_TRANSCRICAO_PROVIDER=auto    # auto | whisper_local | off
SDR_WHISPER_MODEL=small          # tiny|base|small|medium|large-v3 (motor faster-whisper)
SDR_TELEGRAM_BOT_TOKEN=
SDR_TELEGRAM_BOT_USERNAME=

# Segurança
# Assina a sessão do chat do site (impede um visitante de entrar na conversa de outro), o link de
# conexão do Google Agenda e cifra o refresh token da agenda. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem valor, cada processo gera o seu no boot e as sessões caem a cada reinício.
SDR_SESSAO_SECRET=
SDR_PAINEL_TOKEN=                  # credencial do painel (API e WS papel=dashboard)
# Origens permitidas na API, separadas por vírgula. Vazio = no perfil local, só os front-ends do
# compose (5173, 5174, 3000); fora dele, nenhuma origem externa.
SDR_CORS_ORIGINS=

# Google Agenda do corretor (opcional)
# Sem estas duas, a Mora usa a grade interna de horários e as visitas continuam sendo marcadas.
# Crie as credenciais em console.cloud.google.com → APIs e Serviços → Credenciais → ID do cliente OAuth
# (tipo "Aplicativo da Web") e cadastre a URI de redirecionamento abaixo.
SDR_GOOGLE_CLIENT_ID=
SDR_GOOGLE_CLIENT_SECRET=
SDR_GOOGLE_REDIRECT_URI=http://localhost:8000/calendario/callback

# CRM imobiliário (ver docs/decisions.md D-01). Vazio = ponte desligada.
# Endpoint do servidor MCP do CRM (não a REST) e a credencial do agente nele. No compose o agente
# recebe SDR_CRM_TOKEN a partir de CRM_MCP_TOKEN (local/.env); fora dele, cole aqui o MESMO valor
# de CRM_MCP_TOKEN. Do host, o servidor MCP do compose fica em http://localhost:8200/mcp.
SDR_CRM_URL=
SDR_CRM_TOKEN=
